# Database Connection
# Format: postgresql://username:password@host:port/database
# IMPORTANT: Update this with your MySQL credentials after installation!
DATABASE_URL="mysql://root:DB_PASSWORD@localhost:3306/mh26_services"

# Redis (optional for development - rate limiting works without it)
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate strong random strings for production!)
JWT_ACCESS_SECRET="change-this-to-a-secure-secret-key-12345"
JWT_REFRESH_SECRET="change-this-to-a-secure-secret-key-67890"

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# AWS S3 (for file uploads - optional for dev, using MinIO in Docker)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=mh26-services-uploads
AWS_REGION=ap-south-1
AWS_ENDPOINT=http://localhost:9000

# Razorpay (payments - test mode - update with your test keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=razorpay_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_placeholder

# Email (optional - for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mh26services@gmail.com
SMTP_PASS="email_app_password_placeholder"

SMTP_FROM="MH26 Services" <mh26services@gmail.com>

# Twilio (SMS - Optional)
TWILIO_ACCOUNT_SID=AC_twilio_sid_placeholder
TWILIO_API_KEY_SID=SK_twilio_api_key_placeholder
TWILIO_API_KEY_SECRET=twilio_secret_placeholder

TWILIO_AUTH_TOKEN=twilio_auth_token_placeholder
TWILIO_FROM_NUMBER=+15555555555
